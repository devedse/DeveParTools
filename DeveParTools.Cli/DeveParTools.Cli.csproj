<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>devepar</AssemblyName>
    <RootNamespace>DeveParTools.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
    <Description>devepar: command-line PAR1/PAR2/PAR3 create, verify and repair.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeveParTools\DeveParTools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DeveParTools.Cli.Tests" />
  </ItemGroup>
</Project>
