<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Devedse</Authors>
    <Company>Devedse</Company>
    <Copyright>Copyright (c) 2026 Devedse</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/devedse/DeveParTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devedse/DeveParTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
