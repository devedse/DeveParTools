<?xml version="1.0" encoding="utf-8"?>
<!--
  Trim warnings in packages that are known to be harmless for this app, suppressed one method at a time so that any
  new warning still fails the build (TreatWarningsAsErrors).
-->
<linker>
  <!--
    FluentAvalonia depends on Avalonia.Controls.DataGrid. Its column binding helper looks properties up by name with
    reflection (IL2070), which trimming cannot follow. The app has no DataGrid, so this code never runs.
  -->
  <assembly fullname="Avalonia.Controls.DataGrid">
    <type fullname="Avalonia.Controls.Utils.TypeHelper">
      <method name="GetPropertyOrIndexer">
        <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
          <argument>Trimming</argument>
          <argument>IL2070</argument>
        </attribute>
      </method>
    </type>
  </assembly>
</linker>
