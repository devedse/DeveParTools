<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Page title. -->
  <Style Selector="TextBlock.Title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.Subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="TextBlock.Section">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.Number">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <!-- Card: a rounded surface on the page background. -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- Legend chips: a colour square and a count; hidden states are faded. -->
  <Style Selector="ToggleButton.Legend">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ToggleButton.Legend:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style Selector="ToggleButton.Legend:unchecked">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
</Styles>
