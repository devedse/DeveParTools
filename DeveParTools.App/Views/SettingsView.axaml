<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveParTools.App.ViewModels"
             x:Class="DeveParTools.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,16,24,16" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="Title" Text="Settings" />
      <Border Classes="Card">
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="14">
          <TextBlock Text="Threads" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding Threads}" Minimum="1" Maximum="{Binding MaxThreads}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Text="Memory budget (MiB)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MemoryMiB}" Minimum="64" Maximum="1048576" Increment="256" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="2" Text="SIMD kernel" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Kernels}" SelectedItem="{Binding Kernel}" Width="160" />
          <TextBlock Grid.Row="3" Text="Theme" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" />
        </Grid>
      </Border>
      <Border Classes="Card" IsVisible="{Binding ExplorerMenuSupported}">
        <StackPanel Spacing="8">
          <TextBlock Classes="Section" Text="Windows Explorer" />
          <ToggleSwitch IsChecked="{Binding ExplorerMenu}" IsEnabled="{Binding ExplorerMenuEditable}"
                        OnContent="Context menu entries on" OffContent="Context menu entries off"
                        AutomationProperties.Name="Explorer context menu entries" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Right-click files or folders for &quot;Create recovery set with DeveParTools&quot; (a multi-selection opens one window), and .par, .par2 or .par3 files for &quot;Verify with DeveParTools&quot;. Only for your Windows account; no administrator rights needed. Windows 11 shows them under &quot;Show more options&quot;. Turn this off before you delete the app." />
          <TextBlock Text="{Binding ExplorerMenuStatus}" TextWrapping="Wrap" IsVisible="{Binding ExplorerMenuStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
      <Border Classes="Card">
        <StackPanel Spacing="6">
          <TextBlock Classes="Section" Text="About" />
          <TextBlock Text="{Binding Version, StringFormat='DeveParTools {0}'}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CpuFeatures, StringFormat='CPU features: {0}'}" />
          <TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" />
          <TextBlock Text="PAR1, PAR2 and PAR3 (including par3cmdline's FFT Reed-Solomon) in one place. MIT licensed." TextWrapping="Wrap" />
          <TextBlock Text="https://github.com/devedse/DeveParTools" Foreground="{DynamicResource AccentStripBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
