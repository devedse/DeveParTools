<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveParTools.App.ViewModels"
             x:Class="DeveParTools.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,16,24,16" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="Title" Text="Settings" />
      <Border Classes="Card">
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="14">
          <TextBlock Text="Threads" VerticalAlignment="Center" />
          <NumericUpDown ToolTip.Tip="How many processor threads the operations use (files are checked in parallel; encoding and hashing are spread over them)." Grid.Column="1" Value="{Binding Threads}" Minimum="1" Maximum="{Binding MaxThreads}" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Text="Memory budget (MiB)" VerticalAlignment="Center" />
          <NumericUpDown ToolTip.Tip="How much memory encoding and repairing may use for their buffers. Less memory means more passes over the files (slower), more lets large sets go in one pass." Grid.Row="1" Grid.Column="1" Value="{Binding MemoryMiB}" Minimum="64" Maximum="1048576" Increment="256" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="2" Text="SIMD kernel" VerticalAlignment="Center" />
          <ComboBox ToolTip.Tip="The SIMD kernel for the Galois-field arithmetic. The fastest one your processor supports is chosen automatically; others are here to compare them on the Benchmark page." Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Kernels}" SelectedItem="{Binding Kernel}" Width="160" />
          <TextBlock Grid.Row="3" Text="Theme" VerticalAlignment="Center" />
          <ComboBox ToolTip.Tip="Light, dark, or follow the system setting." Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="160" />
        </Grid>
      </Border>
      <Border Classes="Card" IsVisible="{Binding AssociationsSupported}">
        <StackPanel Spacing="8">
          <TextBlock Classes="Section" Text="File associations" />
          <ToggleSwitch ToolTip.Tip="Double-click .par, .par2 and .par3 files (and PAR1 volumes) to verify them in DeveParTools." IsChecked="{Binding AssociateFiles}" IsEnabled="{Binding AssociationsEditable}"
                        OnContent="PAR files open with DeveParTools" OffContent="PAR files open with DeveParTools"
                        AutomationProperties.Name="Open PAR files with DeveParTools" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Double-click .par, .par2 and .par3 files (and PAR1 volumes .p01, .p02 …) to verify them in DeveParTools. Only for your account; turning it off gives the files back to the program they had before." />
          <TextBlock Text="{Binding AssociationStatus}" TextWrapping="Wrap" IsVisible="{Binding AssociationStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button ToolTip.Tip="Opens Windows&#x27; Default apps settings, where you can pick DeveParTools for the PAR file types yourself (Windows does not let apps do that)." Content="Choose in Windows…" Command="{Binding OpenDefaultAppsCommand}" IsVisible="{Binding CanOpenDefaultApps}" />
        </StackPanel>
      </Border>
      <Border Classes="Card" IsVisible="{Binding ExplorerMenuSupported}">
        <StackPanel Spacing="8">
          <TextBlock Classes="Section" Text="Windows Explorer" />
          <ToggleSwitch ToolTip.Tip="Adds &#x27;Create recovery set with DeveParTools&#x27; to files and folders and &#x27;Verify with DeveParTools&#x27; to PAR files in the Explorer right-click menu." IsChecked="{Binding ExplorerMenu}" IsEnabled="{Binding ExplorerMenuEditable}"
                        OnContent="Context menu entries on" OffContent="Context menu entries off"
                        AutomationProperties.Name="Explorer context menu entries" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Right-click files or folders for &quot;Create recovery set with DeveParTools&quot; (a multi-selection opens one window), and .par, .par2 or .par3 files for &quot;Verify with DeveParTools&quot;. Only for your Windows account; no administrator rights needed. Windows 11 shows them under &quot;Show more options&quot;. Turn this off before you delete the app." />
          <TextBlock Text="{Binding ExplorerMenuStatus}" TextWrapping="Wrap" IsVisible="{Binding ExplorerMenuStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
      <Border Classes="Card">
        <StackPanel Spacing="8">
          <TextBlock Classes="Section" Text="Updates" />
          <ToggleSwitch ToolTip.Tip="When DeveParTools starts, ask GitHub whether a newer version was released (at most once a day; only the program's name and version are sent). A banner then offers the update."
                        IsChecked="{Binding CheckForUpdates}"
                        OnContent="Check for updates automatically" OffContent="Check for updates automatically"
                        AutomationProperties.Name="Check for updates automatically" />
          <TextBlock Text="{Binding Updates.StatusText}" TextWrapping="Wrap" IsVisible="{Binding Updates.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Check now" Command="{Binding Updates.CheckNowCommand}"
                    ToolTip.Tip="Ask GitHub now for the latest release." />
            <Button Classes="accent" Content="Update…" Command="{Binding Updates.OpenUpdateWindowCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="Shows what the update does, then downloads and installs it with a progress bar. DeveParTools restarts when it is done." />
            <Button Content="What's new" Command="{Binding Updates.OpenReleasePageCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="Opens the release page on GitHub." />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="Card">
        <StackPanel Spacing="6">
          <TextBlock Classes="Section" Text="About" />
          <TextBlock Text="{Binding Version, StringFormat='DeveParTools {0}'}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CpuFeatures, StringFormat='CPU features: {0}'}" />
          <TextBlock Text="{Binding Runtime}" TextWrapping="Wrap" />
          <TextBlock Text="PAR1, PAR2 and PAR3 (including par3cmdline's FFT Reed-Solomon) in one place. MIT licensed." TextWrapping="Wrap" />
          <TextBlock Text="https://github.com/devedse/DeveParTools" Foreground="{DynamicResource AccentStripBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
