<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeveParTools.App.ViewModels"
             xmlns:c="using:DeveParTools.App.Controls"
             xmlns:views="using:DeveParTools.App.Views"
             x:Class="DeveParTools.App.Views.CreateView"
             x:DataType="vm:CreateViewModel"
             c:FileDrop.Command="{Binding AddPathsCommand}">
  <UserControl.Styles>
    <!-- Label / value pairs in the summary. -->
    <Style Selector="TextBlock.Label">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Value">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <!-- At least 980 × 720: smaller windows scroll instead of squeezing the cards into each other. -->
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,16,24,16" RowSpacing="14"
        Width="{Binding #PageScroll.Viewport.Width, Converter={x:Static c:AtLeastConverter.Instance}, ConverterParameter='980|48'}"
        Height="{Binding #PageScroll.Viewport.Height, Converter={x:Static c:AtLeastConverter.Instance}, ConverterParameter='720|32'}">
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="Title" Text="Create a recovery set" />
      <TextBlock Classes="Subtitle" Text="Choose what to protect and how much recovery data to make. Every number below is what will really be written." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="12">
      <!-- Left: inputs, output, create -->
      <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto,Auto,Auto" RowSpacing="12">
        <Border Classes="Card">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="Section" Margin="0" Text="Files and folders" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button ToolTip.Tip="Pick one or more files to protect." Content="Add files…" Command="{Binding AddFilesCommand}" />
                <Button ToolTip.Tip="Pick a folder to protect: all its files (and its subfolders&#x27; files, see Advanced options)." Content="Add folder…" Command="{Binding AddFolderCommand}" />
                <Button ToolTip.Tip="Remove everything from the list (the files themselves are not touched)." Content="Clear" Command="{Binding ClearInputsCommand}" />
              </StackPanel>
            </Grid>
            <!-- Column headers -->
            <Grid Grid.Row="1" ColumnDefinitions="*,70,90,80,76" Margin="12,4,12,0" IsVisible="{Binding HasInputs}">
              <TextBlock Classes="Caption" Text="Name" />
              <TextBlock Grid.Column="1" Classes="Caption" Text="Files" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Classes="Caption" Text="Size" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Classes="Caption" Text="Blocks" HorizontalAlignment="Right" />
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CreateInputRow">
                  <Grid ColumnDefinitions="*,70,90,80,76" ToolTip.Tip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Files}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Blocks}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button ToolTip.Tip="Take this file or folder out of the list (the file itself is not touched)." Grid.Column="4" Content="Remove" Padding="8,2" HorizontalAlignment="Right"
                            Command="{Binding $parent[UserControl].((vm:CreateViewModel)DataContext).RemoveInputCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{Binding InputSummary}" Opacity="0.8" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="Card">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Text="Save as" VerticalAlignment="Center" />
            <TextBox ToolTip.Tip="The index file of the new set. The recovery files get the same name with .volXX+YY added; they are written into the same folder." Grid.Column="1" Text="{Binding OutputPath}" PlaceholderText="{Binding OutputPlaceholder}" />
            <Button ToolTip.Tip="Choose where to save the recovery set and its name." Grid.Column="2" Content="Browse…" Command="{Binding BrowseOutputCommand}" />
            <TextBlock Grid.Row="1" Text="Comment" VerticalAlignment="Center" />
            <TextBox ToolTip.Tip="Optional text stored in the set (shown when it is verified), for example what the files are." Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Comment}" PlaceholderText="optional, stored in the set" />
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <Button ToolTip.Tip="Write the recovery set with exactly the numbers shown on the right." Classes="accent" Content="Create recovery set" Command="{Binding CreateCommand}" Padding="20,8" />
          <Button ToolTip.Tip="Stop creating. The files written so far are not a usable set." Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
        <views:OperationProgressView Grid.Row="3" />
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>

      <!-- Right: choices with their real numbers, then the live block grid -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <!-- Format and blocks -->
            <Border Classes="Card">
              <Grid ColumnDefinitions="Auto,*,190" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                <TextBlock Text="Format" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="PAR3: protects folder trees, fast for large sets (FFT code), can store permissions; read by DeveParTools and par3cmdline. PAR2: read by almost every PAR tool (par2cmdline, MultiPar, QuickPar …), at most 32,768 blocks. PAR1: only for very old tools; one block per file." />

                <TextBlock Grid.Row="1" Text="Blocks" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding BlockSliderMaximum}" Value="{Binding BlockSlider}" IsEnabled="{Binding HasBlockChoice}"
                        ToolTip.Tip="Your files are cut into blocks; a recovery block can replace any one lost block. More blocks: damage is repaired more precisely, but every block costs checksums and work. Fewer blocks: less overhead, but a small error costs a whole block." />
                <NumericUpDown Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Value="{Binding BlockCount}" Minimum="1" FormatString="N0" IsEnabled="{Binding HasBlockChoice}"
                               AutomationProperties.Name="Number of blocks" ToolTip.Tip="Number of input blocks. Type one to aim for it; the real count can differ a little, because every file is rounded up to whole blocks." />

                <TextBlock Grid.Row="2" Text="Block size" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <TextBlock Classes="Value" Text="{Binding BlockSizeText}" />
                  <TextBlock Classes="Label" Text="{Binding BlockFillText}"
                             ToolTip.Tip="The last block of every file is only partly filled; the rest is padding that the recovery blocks protect for nothing." />
                </StackPanel>
                <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding BlockSize}" Minimum="4" ShowButtonSpinner="False" FormatString="N0"
                               IsEnabled="{Binding HasBlockChoice}" AutomationProperties.Name="Block size in bytes"
                               ToolTip.Tip="Block size in bytes. Type one to use exactly that (rounded up to a multiple of 4 for PAR2, 8 for PAR3)." />

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Spacing="6">
                  <TextBlock Classes="Caption" Text="PAR1 uses one block per file." IsVisible="{Binding IsPar1}" />
                  <CheckBox Content="Allow more than 32,768 blocks" IsChecked="{Binding AllowManyBlocks}" IsVisible="{Binding ShowManyBlocksOption}"
                            ToolTip.Tip="Up to 32,768 blocks the set keeps the full guarantee: any lost blocks can be rebuilt as long as there are as many recovery blocks. More blocks are possible with PAR3, with the drawbacks shown when you use them." />
                  <Border IsVisible="{Binding ManyBlocksWarning}" Padding="10,8" CornerRadius="6" Background="{DynamicResource BlockRecoverableBrush}" Opacity="0.9">
                    <TextBlock TextWrapping="Wrap" Foreground="Black"
                               Text="More than 32,768 blocks: a small error costs less recovery data, but (1) the FFT code then splits the set into interleaved groups that each repair only their own blocks, so damage concentrated in one place may not be repairable even when there is enough recovery data in total; (2) every block adds a 24-byte checksum to the index and to every recovery file, so the PAR files grow; (3) verify and repair keep a table of all blocks and take longer." />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Recovery -->
            <Border Classes="Card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,190" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                  <TextBlock Text="Redundancy" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Redundancy}"
                          ToolTip.Tip="Recovery blocks as a percentage of the input blocks: 10% can repair up to 10% of the blocks being lost or damaged, wherever they are." />
                  <TextBlock Grid.Column="2" Classes="Value" Text="{Binding RedundancyText}" HorizontalAlignment="Right" />

                  <TextBlock Grid.Row="1" Text="Recovery blocks" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="Label" Text="exact number (instead of the percentage)" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding RecoveryCount}" Minimum="0" Maximum="{Binding RecoveryCountMaximum}" FormatString="N0"
                                 AutomationProperties.Name="Number of recovery blocks"
                                 ToolTip.Tip="Each recovery block can replace one lost or damaged input block. Type a number to use exactly that many." />

                  <TextBlock Grid.Row="2" Text="Recovery files" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding VolumeSizings}" SelectedIndex="{Binding VolumeSizingIndex}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding HasBlockChoice}"
                            ToolTip.Tip="How the recovery blocks are spread over files. Growing (1, 2, 4, 8 …): to repair a little damage you only need to download or keep the small files. Equal: files of the same size. Limited: no file larger than your largest file." />
                  <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding VolumeCount}" Minimum="0" PlaceholderText="automatic" FormatString="N0"
                                 IsEnabled="{Binding HasBlockChoice}" AutomationProperties.Name="Number of recovery files"
                                 ToolTip.Tip="How many recovery files to make. Empty: as many as the growing sizes need (Growing) or one (Equal)." />
                </Grid>

                <!-- What the choices give -->
                <Border Padding="12" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                    <TextBlock Classes="Label" Text="PAR files" />
                    <TextBlock Grid.Column="1" Classes="Value" Text="{Binding ParFilesText}"
                               ToolTip.Tip="Everything that will be written: the index file and the recovery files, with all their checksums and copies of the file list." />
                    <TextBlock Grid.Row="1" Classes="Label" Text="Recovery data" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="Value" Text="{Binding RecoveryDataText}"
                               ToolTip.Tip="The recovery blocks themselves, without the packets around them." />
                    <TextBlock Grid.Row="2" Classes="Label" Text="Efficiency" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="Value" Text="{Binding EfficiencyText}"
                               ToolTip.Tip="How much of what is written protects your data: the data the recovery blocks stand for, divided by the size of all PAR files. The rest is overhead: partly empty blocks, a checksum per block, and copies of the file list and checksums in every recovery file (so each one also works on its own). Many small blocks lower it; fewer, larger blocks raise it." />
                    <TextBlock Grid.Row="3" Classes="Label" Text="Missing files it can rebuild" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="Value" Text="{Binding RebuildText}"
                               ToolTip.Tip="Whole files that can be recreated when they are gone completely: the first number if the largest files are lost, the second if the smallest are." />
                    <TextBlock Grid.Row="4" Classes="Label" Text="Code" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="Value" Text="{Binding CodeText}"
                               ToolTip.Tip="The error-correcting code that computes the recovery blocks, and the Galois field it calculates in." />
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="4" IsVisible="{Binding HasWarnings}">
                      <ItemsControl ItemsSource="{Binding Errors}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='⛔ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource BlockMissingBrush}" Margin="0,4,0,0" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource BlockRecoverableBrush}" Margin="0,4,0,0" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>

                <Expander ToolTip.Tip="Every file that will be written, with what it holds and its exact size." Header="{Binding RecoveryFilesHeader}" HorizontalAlignment="Stretch" Padding="12,8">
                  <ItemsControl ItemsSource="{Binding RecoveryFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecoveryFileRow">
                        <Grid ColumnDefinitions="*,110,90" Margin="0,2">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Blocks}" HorizontalAlignment="Right" Opacity="0.8" />
                          <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </Border>

            <!-- PAR3 -->
            <Border Classes="Card" IsVisible="{Binding IsPar3}">
              <StackPanel Spacing="8">
                <TextBlock Classes="Section" Margin="0" Text="PAR3 options" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                  <TextBlock Text="Code" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Codes}" SelectedIndex="{Binding CodeIndex}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Automatic: Cauchy for small sets (up to 256 blocks in all) and when there are more recovery than input blocks, FFT otherwise. Cauchy: the classic Reed-Solomon code from the PAR3 specification; any number of recovery blocks, but its work grows with input × recovery blocks, so large sets are slow. FFT: Reed-Solomon computed with fast Fourier transforms, many times faster for large sets; at most as many recovery blocks as input blocks (set the most you will ever need under Advanced options). FFT sets are read by DeveParTools and par3cmdline." />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="Caption" Text="{Binding CodeChoiceText}" IsVisible="{Binding CodeChoiceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
                <WrapPanel>
                  <CheckBox Content="Deduplicate identical blocks" IsChecked="{Binding Dedup}" Margin="0,0,16,0"
                            ToolTip.Tip="Blocks with exactly the same content (copies of a file, long runs of zeros) are stored once, so there are fewer blocks to protect and less recovery data for the same percentage. Which blocks are the same is only known when the files are read, so the numbers above are without it: the real set can be smaller." />
                  <CheckBox Content="Pack file tails" IsChecked="{Binding PackTails}" Margin="0,0,16,0"
                            ToolTip.Tip="The last, partly filled block of each file is packed together with other files' last pieces into shared blocks, instead of each taking a whole block. Saves blocks and recovery data with many small files." />
                  <CheckBox Content="Store data (archive)" IsChecked="{Binding StoreData}" Margin="0,0,16,0"
                            ToolTip.Tip="Also copies the contents of your files into the PAR files (.part files), so the PAR set alone can recreate everything, like an archive. The PAR files then become as large as your files plus the recovery data." />
                  <CheckBox Content="Store Unix permissions" IsChecked="{Binding UnixPermissions}" Margin="0,0,16,0"
                            ToolTip.Tip="Stores each file's modification time, owner, group and permission bits, so a repair can restore them (Verify page: Restore permissions)." />
                  <CheckBox Content="Store Windows attributes" IsChecked="{Binding FatPermissions}" Margin="0,0,16,0"
                            ToolTip.Tip="Stores each file's creation and modification times and attributes (read-only, hidden, system, archive), so a repair can restore them." />
                  <CheckBox Content="Reproducible output" IsChecked="{Binding Reproducible}"
                            ToolTip.Tip="The same files and settings always give byte-for-byte the same PAR files (the set's ID is derived from the contents instead of chosen at random). Handy for comparing or deduplicating backups." />
                </WrapPanel>
                <CheckBox IsVisible="{Binding CanInsertIntoArchive}" IsChecked="{Binding InsideArchive}"
                          Content="Store the recovery data inside the archive itself, so it can repair itself (PAR inside)"
                          ToolTip.Tip="Appends the PAR3 data to the .zip, .7z or .rar itself. Archive tools still open it, and DeveParTools (or par3cmdline) can verify and repair it from the archive alone. The Verify page can remove it again." />
              </StackPanel>
            </Border>

            <!-- Rarely needed -->
            <Expander ToolTip.Tip="Options most sets do not need: the first block number, the base folder, subfolders, and PAR3 code details." Header="Advanced options" HorizontalAlignment="Stretch" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                <TextBlock Text="First recovery block" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding FirstRecoveryBlock}" Minimum="0" Maximum="65535" PlaceholderText="0" FormatString="N0"
                               ToolTip.Tip="Number of the first recovery block. Use another start to make extra recovery files for the same files later." />
                <TextBlock Grid.Row="1" Text="Base folder" VerticalAlignment="Center" />
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding BaseDirectory}" PlaceholderText="the folder of the recovery set" ToolTip.Tip="File names are stored relative to this folder." />
                  <Button ToolTip.Tip="Choose the base folder: file names are stored relative to it." Grid.Column="1" Content="Browse…" Command="{Binding BrowseBaseCommand}" />
                </Grid>
                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="Include subfolders" IsChecked="{Binding Recursive}"
                          ToolTip.Tip="For folders you added: also protect the files in their subfolders (and their subfolders, and so on)." />
                <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10" IsVisible="{Binding IsPar3}">
                  <TextBlock Text="Most recovery blocks ever (FFT)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding MaxRecoveryBlocks}" Minimum="0" Maximum="32768" PlaceholderText="automatic" FormatString="N0"
                                 ToolTip.Tip="An FFT set can only be extended up to this number of recovery blocks." />
                  <TextBlock Grid.Row="1" Text="Extra cohorts (FFT interleave)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Interleave}" Minimum="0" Maximum="255" PlaceholderText="automatic" FormatString="N0"
                                 ToolTip.Tip="Splits very large sets into interleaved groups (0 or empty: automatic)." />
                  <TextBlock Grid.Row="2" Text="Cauchy coefficients" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CauchyConventions}" SelectedIndex="{Binding CauchyConventionIndex}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="The PAR3 draft specification and par3cmdline (the reference program) number the Cauchy matrix differently. Keep par3cmdline unless a program that follows the specification text must read the set; DeveParTools reads both." />
                </Grid>
              </Grid>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Classes="Card" Padding="12" Height="230" IsVisible="{Binding ShowBlocks}">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Classes="Section" Margin="0" Text="Input blocks read by the encoder"
                       ToolTip.Tip="One square per input block (or per group of blocks in large sets). A block turns green when the encoder has read it to compute the recovery blocks." />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <c:BlockGrid Map="{Binding Map}" Version="{Binding MapVersion}" CellSize="{Binding CellSize}" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Expander ToolTip.Tip="Everything that happened, with times: each step, warnings and errors." Grid.Row="2" Header="Log" HorizontalAlignment="Stretch">
      <ListBox ItemsSource="{Binding Log}" Height="150">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLine">
            <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Expander>
  </Grid>
  </ScrollViewer>
</UserControl>
