<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:DeveParTools.App.ViewModels"
        xmlns:c="using:DeveParTools.App.Controls"
        x:Class="DeveParTools.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="DeveParTools"
        Icon="/Assets/icon.png"
        Width="1280" Height="820" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <ui:FANavigationView PaneDisplayMode="Auto"
                       IsBackButtonVisible="False"
                       IsSettingsVisible="False"
                       IsPaneToggleButtonVisible="True"
                       OpenPaneLength="220"
                       CompactModeThresholdWidth="820"
                       ExpandedModeThresholdWidth="1100"
                       PaneTitle="DeveParTools"
                       MenuItemsSource="{Binding MenuPages}"
                       FooterMenuItemsSource="{Binding FooterPages}"
                       SelectedItem="{Binding SelectedNavigation}">
    <ui:FANavigationView.MenuItemTemplate>
      <DataTemplate x:DataType="vm:NavigationItem">
        <ui:FANavigationViewItem Content="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                 IconSource="{Binding IconKey, Converter={x:Static c:ResourceIconSourceConverter.Instance}}" />
      </DataTemplate>
    </ui:FANavigationView.MenuItemTemplate>
    <ContentControl Content="{Binding CurrentPage}" />
  </ui:FANavigationView>
</Window>
